        "description": "string?",
        "location": "string?",
        "startTime": "string?",
        "endTime": "string?",
        "allDay": "boolean?",
        "timeZone": "string?",
        "notificationLevel": "enum? default ALL",
        "addGoogleMeetUrl": "boolean?",
        "googleMeetUrl": "string?",
        "visibility": "string?",
        "colorId": "string?",
        "addedAttendees": "Attendee[]?",
