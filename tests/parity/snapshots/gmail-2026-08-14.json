{
  "vendor": "gmail",
  "product": "Google Gmail MCP server",
  "endpoint": "https://gmailmcp.googleapis.com/mcp/v1",
  "captured": "2026-08-14",
  "status": "Developer Preview (Google Workspace Developer Preview Program)",
  "provenance": "published reference (developers.google.com/workspace/gmail/api/reference/mcp) plus a live tools/list capture for the eight trash/spam tools whose doc pages 404",
  "confidence": "high for the 11 documented tools; high for the 8 live tools (schemas read from the server's own tools/list)",
  "notes": "No send tool exists \u2014 the server drafts, reads, labels, and triages; a person sends. apply_sensitive_message_label / apply_sensitive_thread_label are cross-referenced in docs but not served; deliberately not emulated.",
  "tools": {
    "search_threads": {
      "params": {
        "query": "string?",
        "pageSize": "integer? default 20 max 50",
        "pageToken": "string?",
        "includeTrash": "boolean? default false",
        "view": "enum? ThreadView default THREAD_VIEW_MINIMAL"
      },
      "returns": [
        "threads",
        "nextPageToken",
        "resultCountEstimate"
      ]
    },
    "get_thread": {
      "params": {
        "threadId": "string!",
        "messageFormat": "enum? MessageFormat default FULL_CONTENT"
      },
      "returns": [
        "id",
        "messages"
      ]
    },
    "get_message": {
      "params": {
        "messageId": "string!",
        "messageFormat": "enum? MessageFormat default FULL_CONTENT"
      },
      "returns": [
        "Message"
      ]
    },
    "list_drafts": {
      "params": {
        "pageSize": "integer? default 20 max 50",
        "pageToken": "string?",
        "query": "string?",
        "view": "enum? DraftView default DRAFT_VIEW_FULL"
      },
      "returns": [
        "drafts",
        "nextPageToken"
      ]
    },
    "create_draft": {
      "params": {
        "to": "string[]?",
        "cc": "string[]?",
        "bcc": "string[]?",
        "subject": "string?",
        "body": "string?",
        "htmlBody": "string?",
        "replyToMessageId": "string?",
        "attachments": "Attachment[]?"
      },
      "returns": [
        "Draft"
      ]
    },
    "list_labels": {
      "params": {
        "pageSize": "integer?",
        "pageToken": "string?"
      },
      "returns": [
        "labels",
        "nextPageToken"
      ]
    },
    "create_label": {
      "params": {
        "displayName": "string!",
        "color": "LabelColor?"
      },
      "returns": [
        "Label"
      ]
    },
    "label_message": {
      "params": {
        "messageId": "string!",
        "labelIds": "string[]!"
      },
      "returns": [],
      "idempotent": true
    },
    "unlabel_message": {
      "params": {
        "messageId": "string!",
        "labelIds": "string[]!"
      },
      "returns": [],
      "idempotent": true
    },
    "label_thread": {
